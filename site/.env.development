# Loaded by `vite dev` (`make run`). Committed — public, non-secret values only.
# Add `VITE_`-prefixed vars here as the site needs them; Vite inlines them
# into the bundle. Override locally in `.env.development.local` (gitignored).

VITE_APP_URL=http://localhost:3001
VITE_SITE_URL=http://localhost:3000
